# Dependencies and build output (jangan masuk build context)
node_modules
.next

# VCS
.git

# Environment files (jangan pernah masuk build context)
.env*
!.env.example

# Local-only scratch notes at repo root
/*.txt

# Locally uploaded files must not enter the image; keep the placeholders so the
# upload directories exist for the unprivileged runtime user.
public/uploads/receipts/*
!public/uploads/receipts/.gitkeep
public/uploads/distribution/*
!public/uploads/distribution/.gitkeep

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
.vscode
.idea
.zed
*.swp
*.swo

# Local caches / worktrees
.playwright-mcp
.vercel
.worktrees

# Build artifacts
dist
build
coverage
*.tsbuildinfo

# Docker / deployment files
Dockerfile
docker-compose*.yml

# Docs / repo meta
*.md
!README.md
docs
.github

# Local-only helpers
.freebuff
Dockerfile.local
*.bat
