DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/jumat_berkah"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

ADMIN_EMAIL="admin@example.com"
ADMIN_NAME="Admin Jumat Berkah"
ADMIN_LOGIN_CODE="replace-with-local-admin-login-code"
DONOR_LOGIN_CODE="replace-with-local-donor-login-code"

MIDTRANS_SERVER_KEY="SB-Mid-server-your-server-key"
MIDTRANS_CLIENT_KEY="SB-Mid-client-your-client-key"
MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_MERCHANT_ID="your-merchant-id"
MIDTRANS_ENABLED_PAYMENTS=""

AUTH_SECRET="replace-with-secure-random-secret"
AUTH_URL="http://localhost:3000"

TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET="replace-with-secure-random-telegram-secret"
TELEGRAM_ADMIN_CHAT_IDS=""
TELEGRAM_NOTIFY_CHAT_ID=""
TELEGRAM_NOTIFY_ENABLED="false"

# Receipt storage / expense approval
RECEIPT_STORAGE_BUCKET="jumat-berkah-receipts"
RECEIPT_STORAGE_BASE_URL="https://your-app.example.com"
RECEIPT_SIGNED_URL_SECRET="replace-with-long-random-secret"
RECEIPT_STORAGE_PUT_URL=""
EXPENSE_APPROVAL_THRESHOLD_RUPIAH="500000"
EXPENSE_APPROVAL_REQUIRED_COUNT="2"

# Telegram donor self-service
TELEGRAM_DONOR_REMINDER_ENABLED="true"

# Telegram public broadcast channel (bot must be channel admin)
TELEGRAM_PUBLIC_CHANNEL_ID=-1000000000000
# Telegram operational/security alerts
TELEGRAM_FAILED_LOGIN_ALERT_THRESHOLD=5
TELEGRAM_FAILED_LOGIN_ALERT_WINDOW_MINUTES=15
TELEGRAM_ALERT_COOLDOWN_MINUTES=30
TELEGRAM_LARGE_EXPENSE_ALERT_THRESHOLD_RUPIAH=500000
