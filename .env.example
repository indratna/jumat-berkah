DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/jumat_berkah"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

ADMIN_EMAIL="admin@example.com"
ADMIN_NAME="Admin Jumat Berkah"
ADMIN_LOGIN_CODE="replace-with-local-admin-login-code"
DONOR_LOGIN_CODE="replace-with-local-donor-login-code"

MIDTRANS_SERVER_KEY="SB-Mid-server-your-server-key"
MIDTRANS_CLIENT_KEY="SB-Mid-client-your-client-key"
MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_MERCHANT_ID="your-merchant-id"
MIDTRANS_ENABLED_PAYMENTS=""

AUTH_SECRET="replace-with-secure-random-secret"
AUTH_URL="http://localhost:3000"

TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET="replace-with-secure-random-telegram-secret"
TELEGRAM_ADMIN_CHAT_IDS=""
TELEGRAM_NOTIFY_CHAT_ID=""
TELEGRAM_NOTIFY_ENABLED="false"

# Receipt storage / expense approval
RECEIPT_STORAGE_BUCKET="jumat-berkah-receipts"
RECEIPT_STORAGE_BASE_URL="https://your-app.example.com"
RECEIPT_SIGNED_URL_SECRET="replace-with-long-random-secret"
RECEIPT_STORAGE_PUT_URL=""
EXPENSE_APPROVAL_THRESHOLD_RUPIAH="500000"
EXPENSE_APPROVAL_REQUIRED_COUNT="2"

# Telegram donor self-service
TELEGRAM_DONOR_REMINDER_ENABLED="true"

# Telegram public broadcast channel (bot must be channel admin)
TELEGRAM_PUBLIC_CHANNEL_ID=-1000000000000
# Telegram operational/security alerts
TELEGRAM_FAILED_LOGIN_ALERT_THRESHOLD=5
TELEGRAM_FAILED_LOGIN_ALERT_WINDOW_MINUTES=15
TELEGRAM_ALERT_COOLDOWN_MINUTES=30
TELEGRAM_LARGE_EXPENSE_ALERT_THRESHOLD_RUPIAH=500000

# WhatsApp Cloud API reminders
WHATSAPP_REMINDER_ENABLED=false
WHATSAPP_CLOUD_ACCESS_TOKEN=replace-with-whatsapp-cloud-token
WHATSAPP_CLOUD_PHONE_NUMBER_ID=replace-with-phone-number-id
WHATSAPP_REMINDER_TEMPLATE_NAME=jumat_berkah_reminder
WHATSAPP_REMINDER_TEMPLATE_LANGUAGE=id
WHATSAPP_REMINDER_BATCH_LIMIT=20

# Phase 37 documented optional integration/ops env
ADMIN_EMAIL_NOTIFICATIONS=
CRON_SECRET=replace-with-cron-secret
EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=
TELEGRAM_INVALID_SIGNATURE_ALERT_WINDOW_MINUTES=30
TELEGRAM_LOW_BALANCE_THRESHOLD_RUPIAH=500000
TELEGRAM_LOW_TARGET_PROGRESS_PERCENT=60
TELEGRAM_LOW_TARGET_PROGRESS_DAY_OFFSET=1
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-strong-better-auth-secret-at-least-32-chars
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BETTER_AUTH_ADMIN_EMAIL=
BETTER_AUTH_ADMIN_NAME=Admin Jumat Berkah
BETTER_AUTH_ADMIN_PASSWORD=
JUMAT_BERKAH_DB_CONTAINER=jumat-berkah-postgres
JUMAT_BERKAH_DB_NAME=jumat_berkah
JUMAT_BERKAH_DB_USER=jumat_berkah_user
JUMAT_BERKAH_BACKUP_DIR=/var/backups/jumat-berkah
JUMAT_BERKAH_BACKUP_RETENTION_DAYS=14
JUMAT_BERKAH_BACKUP_LOG=/var/log/jumat-berkah-backup.log
JUMAT_BERKAH_RESTORE_CONTAINER=jumat-berkah-postgres-restore-drill
JUMAT_BERKAH_RESTORE_DB=jumat_berkah_restore
JUMAT_BERKAH_RESTORE_USER=restore_user
JUMAT_BERKAH_RESTORE_PASSWORD=replace-with-restore-drill-password
JUMAT_BERKAH_POSTGRES_IMAGE=postgres:16-alpine
JUMAT_BERKAH_PUBLIC_URL=https://your-domain.example.com/
JUMAT_BERKAH_LOCAL_URL=http://127.0.0.1:3010/
JUMAT_BERKAH_TUNNEL_CONTAINER=jumat-berkah-cloudflared
JUMAT_BERKAH_TUNNEL_LOG=/var/log/jumat-berkah-tunnel-watch.log
JUMAT_BERKAH_TUNNEL_LOG_MAX_BYTES=1048576
