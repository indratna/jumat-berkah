// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  donor
  admin
}

enum DonationStatus {
  pending
  settlement
  expire
  cancel
  deny
  failure
  refund
}

enum ExpenseApprovalStatus {
  approved
  pending_approval
}

model AuthUser {
  id            String        @id
  name          String        @default("")
  email         String        @unique
  emailVerified Boolean       @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  sessions AuthSession[]
  accounts AuthAccount[]

  @@map("auth_users")
}

model AuthSession {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model AuthAccount {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_accounts")
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("auth_verifications")
}

model User {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String?
  email     String     @unique
  role                  UserRole @default(donor)
  telegramChatId        BigInt?  @unique @map("telegram_chat_id")
  telegramReminderOptIn Boolean  @default(false) @map("telegram_reminder_opt_in")
  telegramLinkCode      String?  @unique @map("telegram_link_code")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  donations Donation[]
  expenses  Expense[]
  weeklyTargets WeeklyTarget[]
  distributionReports DistributionReport[]
  auditLogs AuditLog[]

  @@index([role])
  @@map("users")
}

model Donation {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId                String         @unique @map("order_id")
  userId                 String?        @map("user_id") @db.Uuid
  donorName              String?        @map("donor_name")
  donorEmail             String?        @map("donor_email")
  donorPhone             String?        @map("donor_phone")
  whatsappReminderOptIn  Boolean        @default(false) @map("whatsapp_reminder_opt_in")
  whatsappReminderOptInAt DateTime?     @map("whatsapp_reminder_opt_in_at")
  whatsappReminderOptOutAt DateTime?    @map("whatsapp_reminder_opt_out_at")
  isAnonymous            Boolean        @default(false) @map("is_anonymous")
  showNamePublicly       Boolean        @default(true) @map("show_name_publicly")
  amount                 Int
  message                String?
  paymentProvider        String         @default("midtrans") @map("payment_provider")
  paymentMethod          String         @default("qris") @map("payment_method")
  status                 DonationStatus @default(pending)
  midtransTransactionId  String?        @map("midtrans_transaction_id")
  paidAt                 DateTime?      @map("paid_at")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([paidAt])
  @@index([userId])
  @@index([whatsappReminderOptIn])
  @@map("donations")
}

model Expense {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expenseDate DateTime @map("expense_date") @db.Date
  category    String
  description String
  amount      Int
  vendorName  String?  @map("vendor_name")
  receiptUrl       String?                @map("receipt_url")
  approvalStatus   ExpenseApprovalStatus @default(approved) @map("approval_status")
  approvalRequired Int                   @default(1) @map("approval_required")
  approvedAt       DateTime?             @map("approved_at")
  createdBy        String                @map("created_by") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  creator   User              @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  approvals ExpenseApproval[]

  @@index([expenseDate])
  @@index([category])
  @@index([createdBy])
  @@index([approvalStatus])
  @@map("expenses")
}

model ExpenseApproval {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expenseId      String   @map("expense_id") @db.Uuid
  telegramChatId BigInt   @map("telegram_chat_id")
  telegramUserId BigInt   @map("telegram_user_id")
  approvedAt     DateTime @default(now()) @map("approved_at")

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@unique([expenseId, telegramUserId])
  @@index([expenseId])
  @@map("expense_approvals")
}

model MidtransWebhookLog {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String   @map("order_id")
  transactionStatus String   @map("transaction_status")
  fraudStatus       String?  @map("fraud_status")
  signatureValid    Boolean  @map("signature_valid")
  rawPayload        Json     @map("raw_payload")
  receivedAt        DateTime @default(now()) @map("received_at")

  @@index([orderId])
  @@index([receivedAt])
  @@map("midtrans_webhook_logs")
}

model DistributionReport {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cycleStart      DateTime  @map("cycle_start") @db.Date
  title           String
  summary         String
  packageCount    Int?      @map("package_count")
  locationSummary String?   @map("location_summary")
  photoUrls       Json      @default("[]") @map("photo_urls")
  publishedAt     DateTime? @map("published_at")
  createdBy       String    @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([cycleStart])
  @@index([cycleStart])
  @@index([publishedAt])
  @@map("distribution_reports")
}

model WeeklyTarget {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cycleStart   DateTime @map("cycle_start") @db.Date
  cycleEnd     DateTime @map("cycle_end") @db.Date
  targetAmount Int      @map("target_amount")
  note         String?
  createdBy    String   @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([cycleStart])
  @@index([cycleStart])
  @@map("weekly_targets")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  before      Json?
  after       Json?
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
